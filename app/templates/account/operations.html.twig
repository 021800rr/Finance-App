{% extends 'base.html.twig' %}

{% block body %}
    <div class="container mt-4">
        <div class="card mb-4 shadow-sm">
            <div class="card-body">
                <div class="mb-3">
                    <h2 class="h5 mb-1">{{ 'account.history'|trans }}</h2>
                    <div class="text-muted small">
                        <strong>{{ 'account.bank'|trans }}:</strong> {{ account.bank.name }} ·
                        <strong>{{ 'account.type'|trans }}:</strong> {{ account.type.name }} ·
                        <strong>{{ 'account.currency'|trans }}:</strong> {{ account.currency.code }} ·
                        <strong>{{ 'account.number'|trans }}:</strong> <code>{{ account.accountNumber }}</code>
                    </div>
                    <div class="mt-2">
                        <strong>{{ 'account.balance'|trans }}:</strong>
                        {{ saldoAll|money }}
                        {% if showSaldoToday %} ·
                            <strong>{{ 'account.balance_today'|trans }}:</strong> {{ saldoToday|money }}
                        {% endif %}
                    </div>
                    <div class="mt-3">
                        <a class="btn btn-sm btn-primary" href="{{ path('operation_new', {account: account.id}) }}">
                            {{ 'account.add_operation'|trans }}
                        </a>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-sm table-striped table-hover align-middle mb-0">
                        <thead class="table-dark">
                        <tr>
                            <th class="text-end">#</th>
                            <th class="left">{{ 'operation.date'|trans }}</th>
                            <th class="left">{{ 'operation.contractor'|trans }}</th>
                            <th class="left">{{ 'operation.description'|trans }}</th>
                            <th class="text-end">{{ 'operation.amount'|trans }}</th>
                            <th class="text-center"></th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for op in operations %}
                            <tr class="{% if highlight and highlight == op.id %}highlight{% endif %}">
                                <td class="text-end">{{ op.id }}</td>
                                <td class="left">{{ op.operationDate|date('Y-m-d') }}</td>
                                <td class="left">{{ op.contractor.name }}</td>
                                <td class="left text-muted">{{ op.description }}</td>
                                <td class="text-end fw-semibold {{ op.amount|amountClass }}">{{ op.amountAsMoney|money }}</td>
                                <td class="text-center">
                                    <div class="d-flex justify-content-end align-items-center gap-2">
                                        <div class="icon-col text-center">
                                            {% if op.transactionUuid %}
                                                <a href="{{ path('operation_go_to_other_side', {id: op.id}) }}"
                                                   class="btn btn-link p-0 link-icon-plain"
                                                   title="{{ 'operation.show_other_side'|trans }}">
                                                    🔗
                                                </a>
                                            {% endif %}
                                        </div>
                                        <div class="icon-col text-center">
                                            <button
                                                type="button"
                                                class="btn btn-link p-0 op-confirm-toggle {{ op.confirmed ? 'is-confirmed' : 'is-unconfirmed' }}"
                                                data-operation-id="{{ op.id }}"
                                                data-operation-confirmed="{{ op.confirmed ? '1' : '0' }}"
                                                data-toggle-url="{{ path('operation_toggle_confirmed', {id: op.id}) }}"
                                                data-ok-src="{{ asset('images/ok.png') }}"
                                                data-question-src="{{ asset('images/question.png') }}"
                                                aria-label="{{ 'operation.change_confirmation_status'|trans }}"
                                            >
                                                <img
                                                    src="{{ op.confirmed ? asset('images/ok.png') : asset('images/question.png') }}"
                                                    alt=""
                                                    width="20"
                                                    height="20"
                                                >
                                            </button>
                                        </div>
                                        <div class="icon-col text-center">
                                            <a href="{{ path('operation_edit', {id: op.id}) }}" class="btn btn-link p-0" aria-label="{{ 'operation.edit'|trans }}">
                                                <img src="{{ asset('images/edit.png') }}" alt="" width="20" height="20">
                                            </a>
                                        </div>
                                        <div class="icon-col text-center">
                                            {{ include('partials/_delete_button.html.twig', {
                                                deletePath: path('operation_delete', {id: op.id}),
                                                csrfTokenId: 'operation-delete',
                                            }) }}
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="6" class="text-center text-muted">{{ 'operation.none_found'|trans }}</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
                {% if totalPages > 1 %}
                    <div class="d-flex align-items-center justify-content-between mt-3">
                        <nav aria-label="{{ 'pagination.label'|trans }}">
                            <ul class="pagination pagination-sm mb-0">
                                <li class="page-item{% if page <= 1 %} disabled{% endif %}">
                                    <a class="page-link"
                                       href="{{ path('account_operations', {id: account.id, page: page - 1, highlight: highlight}) }}"
                                       aria-label="{{ 'pagination.previous'|trans }}">
                                        ‹
                                    </a>
                                </li>
                                <li class="page-item disabled">
                                    <span class="page-link">
                                        {{ page }} / {{ totalPages }}
                                    </span>
                                </li>
                                <li class="page-item{% if page >= totalPages %} disabled{% endif %}">
                                    <a class="page-link"
                                       href="{{ path('account_operations', {id: account.id, page: page + 1, highlight: highlight}) }}"
                                       aria-label="{{ 'pagination.next'|trans }}">
                                        ›
                                    </a>
                                </li>
                            </ul>
                        </nav>
                        <div class="small text-muted">{{ 'pagination.page_of'|trans({'%page%': page, '%totalPages%': totalPages}) }}</div>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}
