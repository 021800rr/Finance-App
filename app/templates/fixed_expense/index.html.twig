{% extends 'base.html.twig' %}

{% block body %}
    <div class="container mt-4">
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h2 class="h5 mb-0">{{ 'fixed_expense.add_title'|trans }}</h2>
                    <form method="post"
                          action="{{ path('fixed_expense_plan') }}"
                          onsubmit="return confirm('{{ 'fixed_expense.confirm_plan'|trans|e('js') }}');">
                        <input type="hidden" name="_token" value="{{ csrf_token('fixed-expense-plan') }}">
                        <button type="submit" class="btn btn-outline-primary btn-sm">{{ 'fixed_expense.plan_button'|trans }}</button>
                    </form>
                </div>
                {% if form.vars.submitted and not form.vars.valid %}
                    <div class="alert alert-danger mb-3">
                        {{ 'form.fill_required_fields'|trans }}
                    </div>
                {% endif %}

                {% set dayHasError = form.day.vars.errors|length > 0 %}
                {% set amountHasError = form.amount.vars.errors|length > 0 %}
                {% set contractorHasError = form.contractor.vars.errors|length > 0 %}
                {{ form_start(form, {attr: {id: 'fixed_expense_form'}}) }}
                <table class="table table-borderless align-middle w-auto">
                    <tbody>
                    <tr>
                        <th class="pe-3 text-end">{{ 'form.day'|trans }}</th>
                        <td>
                            {{ form_widget(form.day, {
                                attr: {
                                    class: (form.day.vars.attr.class|default('')) ~ (dayHasError ? ' is-invalid' : '')
                                }
                            }) }}
                            <div class="invalid-feedback{% if dayHasError %} d-block{% endif %}">
                                {{ form_errors(form.day) }}
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <th class="pe-3 text-end form-label-wide">{{ 'form.contractor'|trans }}</th>
                        <td class="form-value-wide">
                            {{ include('partials/_contractor_autocomplete.html.twig', {
                                contractorField: form.contractor,
                                contractorHasError: contractorHasError,
                                contractorErrorMessage: contractorErrorMessage|default(null),
                                contractorName: contractorName|default(null),
                                contractorId: contractorId|default(null),
                            }) }}
                        </td>
                    </tr>
                    <tr>
                        <th class="pe-3 text-end">{{ 'form.amount'|trans }}</th>
                        <td>
                            {{ form_widget(form.amount, {
                                attr: {
                                    class: (form.amount.vars.attr.class|default('')) ~ (amountHasError ? ' is-invalid' : '')
                                }
                            }) }}
                            <div class="invalid-feedback{% if amountHasError %} d-block{% endif %}">
                                {{ form_errors(form.amount) }}
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <th class="pe-3 text-end">{{ 'form.description'|trans }}</th>
                        <td>
                            {{ form_widget(form.description) }}
                        </td>
                    </tr>
                    <tr>
                        <td></td>
                        <td class="pt-3">
                            <button type="submit" class="btn btn-primary">{{ 'fixed_expense.add'|trans }}</button>
                        </td>
                    </tr>
                    </tbody>
                </table>
                {{ form_end(form) }}
            </div>
        </div>

        <div class="card mb-4 shadow-sm mt-4">
            <div class="card-body">
                <h2 class="h5 mb-3">{{ 'fixed_expense.list_title'|trans }}</h2>

                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle mb-0">
                        <thead class="table-dark">
                        <tr>
                            <th class="text-end">#</th>
                            <th class="text-end">{{ 'fixed_expense.day'|trans }}</th>
                            <th class="left">{{ 'form.contractor'|trans }}</th>
                            <th class="left">{{ 'form.description'|trans }}</th>
                            <th class="text-end">{{ 'form.amount'|trans }}</th>
                            <th></th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for item in fixedExpenses %}
                            <tr>
                                <td class="text-end">{{ item.id }}</td>
                                <td class="text-end">{{ item.day }}</td>
                                <td class="left">{{ item.contractor.name }}</td>
                                <td class="left text-muted">{{ item.description }}</td>
                                <td class="text-end {{ item.amount|amountClass }}">{{ item.amountAsMoney|money }}</td>
                                <td>
                                    <div class="d-inline-flex align-items-center gap-2">
                                        <a href="{{ path('fixed_expense_edit', {id: item.id}) }}" class="btn btn-link p-0" aria-label="{{ 'operation.edit'|trans }}">
                                            <img src="{{ asset('images/edit.png') }}" alt="" width="20" height="20">
                                        </a>
                                        {{ include('partials/_delete_button.html.twig', {
                                            deletePath: path('fixed_expense_delete', {id: item.id}),
                                            csrfTokenId: 'fixed-expense-delete',
                                        }) }}
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="6" class="text-center text-muted">{{ 'fixed_expense.none_found'|trans }}</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
