<div
    data-controller="contractor-autocomplete"
    data-search-url="{{ path('contractor_search') }}"
    data-create-url="{{ path('contractor_create') }}"
    data-msg-no-name="{{ 'contractor_autocomplete.no_name'|trans }}"
    data-msg-selected="{{ 'contractor_autocomplete.selected'|trans({'%name%': '{name}'}) }}"
    data-msg-confirm-create="{{ 'contractor_autocomplete.confirm_create'|trans({'%name%': '{name}'}) }}"
    data-msg-empty-name="{{ 'contractor_autocomplete.empty_name'|trans }}"
    data-msg-missing-create-url="{{ 'contractor_autocomplete.missing_create_url'|trans }}"
    data-msg-create-failed="{{ 'contractor_autocomplete.create_failed'|trans }}"
    data-msg-created="{{ 'contractor_autocomplete.created'|trans({'%name%': '{name}'}) }}"
    data-msg-created-without-id="{{ 'contractor_autocomplete.created_without_id'|trans }}"
    data-msg-network-error="{{ 'contractor_autocomplete.network_error'|trans }}"
    class="position-relative"
>
    <input
        id="contractor_input"
        name="contractor_input"
        type="text"
        placeholder="{{ 'form.contractor_placeholder'|trans }}"
        data-contractor-autocomplete-target="input"
        autocomplete="off"
        class="form-control{% if contractorHasError %} is-invalid{% endif %}"
        value="{{ contractorName|default('') }}"
    >
    {{ form_widget(contractorField, {
        attr: {
            'data-contractor-autocomplete-target': 'hidden',
            'id': 'contractor_id'
        },
        value: contractorId|default('')
    }) }}
    <div id="contractor_error" class="invalid-feedback{% if contractorHasError or contractorErrorMessage %} d-block{% endif %}">
        {% if contractorErrorMessage %}
            {{ contractorErrorMessage|trans }}
        {% elseif contractorHasError %}
            {{ form_errors(contractorField) }}
        {% else %}
            {{ 'contractor.required'|trans }}
        {% endif %}
    </div>
    <div
        data-contractor-autocomplete-target="results"
        class="autocomplete-results mt-2"
    ></div>
    <div
        data-contractor-autocomplete-target="message"
        class="small mt-1"
    ></div>
</div>
